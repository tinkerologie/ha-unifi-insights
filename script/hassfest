#!/bin/bash

# script/hassfest: Run Home Assistant hassfest validation
#
# Validates the integration against Home Assistant's official validation rules
# using hassfest from the Home Assistant Core repository.
#
# On first run, clones HA Core (~27 MB) to .local/ha-core
# Defaults to Core dev so new manifest metadata is validated against current rules.
# Subsequent runs reuse the cached checkout (use --update to fetch new commits).
# Set HA_VERSION explicitly to validate against a particular release instead.
#
# Usage:
#   ./script/hassfest [options]
#
# Options:
#   --update             Fetch the latest commit for the selected Core ref
#   --skip-plugins LIST  Comma-separated list of plugins to skip
#                        Default: quality_scale,requirements
#
# Examples:
#   ./script/hassfest               # Use cached version (fast)
#   ./script/hassfest --update      # Update the development validator
#   HA_VERSION=2026.10.2 ./script/hassfest  # Explicit release compatibility check

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"
source "$SCRIPT_DIR/.lib/python.sh"
select_project_python "$PWD"

# Configuration
HA_CORE_DIR=".local/ha-core"
HA_CORE_REPO="https://github.com/home-assistant/core.git"
INTEGRATION_PATH="custom_components/unifi_insights"
INTEGRATION_ABSOLUTE_PATH="$PWD/$INTEGRATION_PATH"

# The validator follows current Core rules independently of the runtime release.
HA_VERSION_TAG="${HA_VERSION:-dev}"

# Parse arguments
UPDATE_CORE=false  # Default to no update for speed
SKIP_PLUGINS="quality_scale,requirements"

while [[ $# -gt 0 ]]; do
    case $1 in
        --update)
            UPDATE_CORE=true
            shift
            ;;
        --skip-plugins)
            SKIP_PLUGINS="$2"
            shift 2
            ;;
        *)
            # Pass unknown args to hassfest
            break
            ;;
    esac
done

log_header "Home Assistant hassfest validation"
log_info "Target version: $HA_VERSION_TAG"

# Check if HA Core is already cloned
if [ ! -d "$HA_CORE_DIR" ]; then
    log_info "Cloning Home Assistant Core (sparse checkout, ~5 MB)..."

    # Initialize sparse checkout to only get script/ directory
    mkdir -p "$HA_CORE_DIR"
    cd "$HA_CORE_DIR"
    git init >/dev/null 2>&1
    git remote add origin "$HA_CORE_REPO"
    git config core.sparseCheckout true

    # Only checkout script/ and homeassistant/ directories (needed for hassfest)
    echo "script/" > .git/info/sparse-checkout
    echo "homeassistant/" >> .git/info/sparse-checkout

    # Fetch the specific version (shallow clone + blobless for minimal size)
    if [ "$HA_VERSION_TAG" = "dev" ]; then
        git fetch --depth 1 --filter=blob:none origin dev
        git checkout -B dev FETCH_HEAD >/dev/null 2>&1
    else
        git fetch --depth 1 --filter=blob:none origin tag "$HA_VERSION_TAG"
        git checkout "$HA_VERSION_TAG" >/dev/null 2>&1
    fi
    cd - >/dev/null
    echo ""
else
    # Check if the selected ref changed or a refresh was explicitly requested.
    cd "$HA_CORE_DIR"
    CURRENT_VERSION=$(git symbolic-ref --quiet --short HEAD || git describe --tags --exact-match 2>/dev/null || git rev-parse HEAD)
    cd - >/dev/null

    if [ "$UPDATE_CORE" = true ] || [ "$CURRENT_VERSION" != "$HA_VERSION_TAG" ]; then
        log_info "Updating to version $HA_VERSION_TAG..."
        cd "$HA_CORE_DIR"
        if [ "$HA_VERSION_TAG" = "dev" ]; then
            git fetch --depth 1 --filter=blob:none origin dev >/dev/null 2>&1
            git checkout -B dev FETCH_HEAD >/dev/null 2>&1
        else
            git fetch --depth 1 --filter=blob:none origin tag "$HA_VERSION_TAG" >/dev/null 2>&1
            git checkout "$HA_VERSION_TAG" >/dev/null 2>&1
        fi
        cd - >/dev/null
    else
        log_info "Using cached version $CURRENT_VERSION"
    fi
fi

# Older caches at the right tag still need Core's own dependency files.
git -C "$HA_CORE_DIR" sparse-checkout set --no-cone \
    /script/ /homeassistant/ /requirements.txt /requirements_all.txt /pyproject.toml
for required_file in requirements.txt requirements_all.txt homeassistant/package_constraints.txt; do
    if [[ ! -f "$HA_CORE_DIR/$required_file" ]]; then
        log_error "Cached Home Assistant Core is missing $required_file"
        exit 1
    fi
done

# Check if we have required dependencies
log_info "Checking dependencies..."
# Core dev imports httpx2 before loading validator plugins. Keep the runtime HA
# package intact while adding this validator dependency at Core's own pin.
if [[ "$HA_VERSION_TAG" == "dev" ]] && ! "$PROJECT_PYTHON" -c "import httpx2" >/dev/null 2>&1; then
    log_info "Installing development validator dependency: httpx2"
    if command -v uv >/dev/null 2>&1; then
        uv pip install --python "$PROJECT_PYTHON" -c "$HA_CORE_DIR/requirements.txt" httpx2
    else
        "$PROJECT_PYTHON" -m pip install -c "$HA_CORE_DIR/requirements.txt" httpx2
    fi
fi
if ! "$PROJECT_PYTHON" -c "import tqdm" >/dev/null 2>&1; then
    log_info "Installing hassfest helper dependency: tqdm"
    if command -v uv >/dev/null 2>&1; then
        uv pip install --python "$PROJECT_PYTHON" tqdm
    else
        "$PROJECT_PYTHON" -m pip install tqdm
    fi
fi

if ! "$PROJECT_PYTHON" -c "import voluptuous, awesomeversion, homeassistant.helpers.config_validation" >/dev/null 2>&1; then
    log_error "Missing required dependencies (voluptuous, awesomeversion, homeassistant)"
    log_info "Run: ./script/setup/bootstrap"
    exit 1
fi

# Export PYTHONPATH to include HA Core
export PYTHONPATH="$PWD/$HA_CORE_DIR:${PYTHONPATH:-}"

# Build hassfest command
HASSFEST_CMD=(
    "$PROJECT_PYTHON" -m script.hassfest
    --action validate
    --integration-path "$INTEGRATION_ABSOLUTE_PATH"
    --core-path "$PWD/$HA_CORE_DIR"
)

# Add skip-plugins if specified
if [ -n "$SKIP_PLUGINS" ]; then
    HASSFEST_CMD+=(--skip-plugins "$SKIP_PLUGINS")
fi

# Add remaining arguments
HASSFEST_CMD+=("$@")

# Run hassfest
log_info "Running hassfest validation..."
echo ""
if "${HASSFEST_CMD[@]}"; then
    echo ""
    log_success "Hassfest validation passed"
else
    echo ""
    log_error "Hassfest validation failed"
    exit 1
fi
