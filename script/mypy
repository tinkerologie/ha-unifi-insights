#!/bin/bash

# Run the canonical package check with the project's installed HA dependencies.
# An isolated hook without those dependencies treats HA bases as Any.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

source "$SCRIPT_DIR/.lib/python.sh"
select_project_python "$PWD"
exec "$PROJECT_PYTHON" -m mypy custom_components/unifi_insights
