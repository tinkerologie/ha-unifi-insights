#!/bin/bash
# Check the integration and tests with the selected environment's real types.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."
source "$SCRIPT_DIR/.lib/python.sh"
select_project_python "$PWD"
if ! "$PROJECT_PYTHON" -c 'import pyright' >/dev/null 2>&1; then
    command -v uv >/dev/null 2>&1 || { echo "Install Pyright through ./script/setup/bootstrap" >&2; exit 1; }
    uv pip install --python "$PROJECT_PYTHON" pyright
fi
exec "$PROJECT_PYTHON" -m pyright --project "$PWD/pyrightconfig.json" --pythonpath "$PROJECT_PYTHON" --warnings
